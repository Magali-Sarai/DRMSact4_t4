meta {
  name: 1. Registro de Usuario (POST)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Magali Sarai Diego Revilla",
    "email": "magali@itoaxaca.edu.mx",
    "password": "Password123"
  }
}

script:post-response {
  if (res.body && res.body.token) {
    bru.setEnvVar("token", res.body.token);
  }
}
