meta {
  name: 6. Crear Producto con DTO y Validacion (POST)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/productos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "nombre": "Audífonos Sony USB-C",
    "precio": 850.00,
    "stock": 12,
    "categoriaId": 1
  }
}
